# =============================================================================
# Foakh Broker CRM — backend
#
# Target: Supabase Cloud. No Docker, no local PostgreSQL.
# Development project: foakh-crm-dev   (production later: foakh-crm-prod)
#
# NOTHING in this file may ever appear in a NEXT_PUBLIC_* variable — Next.js
# inlines those into the browser bundle. The service-role key bypasses Row
# Level Security entirely, and DATABASE_URL contains the database password.
# =============================================================================

NODE_ENV=development
PORT=4000

# --- Supabase PostgreSQL -----------------------------------------------------
# DATABASE_URL — Supavisor transaction pooler (port 6543). Used at runtime.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20
#
# connection_limit=1 is the SERVERLESS recipe, where each invocation is its own
# process. In a long-running server it serialises every request through a single
# connection, and concurrent bookings then time out waiting to START a
# transaction rather than being resolved by the row lock. Use 10 or more.
#
# DIRECT_URL — direct connection (port 5432). Used by `prisma migrate`.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# On an IPv4-only network use the Supavisor *session* pooler (port 5432) for
# DIRECT_URL as above; the db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=
DIRECT_URL=

# --- Supabase Auth and Storage ----------------------------------------------
SUPABASE_URL=

# Server-only. Bypasses Row Level Security entirely — never expose to the
# browser. Needed for private document Storage and for provisioning auth users.
# SUPABASE_SECRET_KEY is the current name; SUPABASE_SERVICE_ROLE_KEY is the
# legacy name and is still read as a fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for legacy projects still issuing HS256 tokens. Asymmetric
# (JWKS) verification is used automatically when SUPABASE_URL is set.
SUPABASE_JWT_SECRET=
# Private bucket for CNIC scans, payment proofs and generated invoices. It is
# created automatically at boot if missing. If it already exists and is PUBLIC,
# the server refuses to start rather than write identity documents somewhere
# world-readable.
SUPABASE_STORAGE_BUCKET=foakh-documents

# --- Application -------------------------------------------------------------
SESSION_SECRET=change-me-openssl-rand-base64-48-at-least-32-characters
ENCRYPTION_KEY=change-me-openssl-rand-base64-32
# Comma-separated. Must list the deployed frontend origin in production —
# a request from any other origin is refused.
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

DEFAULT_TIMEZONE=Asia/Karachi
QUEUES_ENABLED=false

# --- Notes -------------------------------------------------------------------
# The server binds 0.0.0.0 on $PORT, so a platform that injects PORT works
# without changes. Health checks:
#
#   GET /api/v1/health         API, database and Supabase reachability
#   GET /api/v1/health/live    liveness (checks nothing external, by design)
#   GET /api/v1/health/ready   readiness (database only)
#
# Seeding is development-only and is deliberately named so:
#
#   pnpm db:seed:dev             demo brokers, clients and inventory
#   pnpm db:provision-auth:dev   Supabase Auth users for the seeded CRM users
#
# Neither should ever be run against production.
