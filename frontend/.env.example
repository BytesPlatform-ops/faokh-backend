# =============================================================================
# Foakh Broker CRM — frontend
#
# Only NEXT_PUBLIC_* variables reach the browser, and Next.js inlines them into
# the client bundle at build time. Never put a database password, a service-role
# key, DATABASE_URL or DIRECT_URL here — they belong in the backend environment.
# =============================================================================

# Where the NestJS API lives. Required whenever NEXT_PUBLIC_DATA_MODE=api; the
# build fails rather than falling back to localhost, because a silent fallback
# makes every screen show a network error that looks like the backend is down.
NEXT_PUBLIC_API_URL=http://localhost:4000

# api  — every screen talks to the NestJS API, which talks to Supabase.
# mock — the CRM runs on the in-memory demo store, no backend needed.
#
# PRODUCTION MUST BE `api`. A production build with anything else fails at build
# time: mock mode serves fabricated inventory and would let a broker "book" a
# unit that does not exist, which looks like a working application and is far
# worse than a build that refuses to start.
NEXT_PUBLIC_DATA_MODE=api

# Escape hatch for building the demo store deliberately — local testing and the
# mock-mode E2E suite, both of which run against an optimised build. Never set
# this in a deployment. `pnpm build:mock` sets it for you.
# NEXT_PUBLIC_ALLOW_MOCK_BUILD=1

# Supabase project foakh-crm-dev (production: foakh-crm-prod).
#
# The publishable (anon) key is designed to be public and is protected by Row
# Level Security, not by secrecy. It is used for authentication only — every
# booking, payment and commission goes through the NestJS API, because those
# need a server-side transaction that a client-side table write cannot provide.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy name for the same value, still read as a fallback.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Scripts -----------------------------------------------------------------
#   pnpm build        production build (requires NEXT_PUBLIC_DATA_MODE=api)
#   pnpm start        serve the production build
#   pnpm build:mock   demo-store build, for local testing and E2E
#   pnpm test         money-parity unit tests
#   pnpm test:e2e     Playwright
